{
  "name": "feetrate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Feetrate Telegram Mini App",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed": "tsx src/db/seed.ts"
  },
  "prisma": {
    "schema": "src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.18.0",
    "@prisma/client": "5.22.0",
    "fastify": "^5.12.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "5.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
